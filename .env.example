# ==================== SCM Copilot 环境变量（复制为 .env 后填写） ====================
# 三类配置：
#   SCM_*   → app.platform.settings（平台基座：DSN / JWT）
#   (无前缀) → app.shared.config（共享层：LLM / Redis / Qdrant / 观测 / 语义路由）
#              —— 双域 config 继承共享配置，kb/ops 特有项在各自 config（env 直接覆盖）

# ---- 平台基座（SCM_ 前缀，pydantic-settings）----
# ★ 生产必须替换（B14）：以下默认值仅供本地开发——DB 密码 / JWT 密钥若直接上生产，
#   等于把门禁凭证公开在仓库里。启动时检测到默认 JWT 密钥会打 WARNING。
# 双库 DSN（本地默认：deploy/docker-compose.yml 起的 MySQL，宿主端口 13306；生产必须替换密码）
SCM_PLATFORM_DSN=mysql+asyncmy://root:root123@127.0.0.1:13306/scm_platform?charset=utf8mb4
SCM_BIZ_DSN=mysql+asyncmy://root:root123@127.0.0.1:13306/scm_biz?charset=utf8mb4
# ★ JWT 签名密钥：生产必须替换为 32+ 字节随机串
#   （生成：python -c "import secrets;print(secrets.token_hex(32))"）
SCM_JWT_SECRET=dev-secret-change-me
# Redis（幂等/缓存/锁；本机部署时宿主端口 16380，见 stage3 deploy）
SCM_REDIS_URL=redis://127.0.0.1:16380/0

# ---- LLM（共享层，mock-first）----
# mock | real（配好 Key 再切 real；无 Key 环境默认 mock，服务不崩）
LLM_PROVIDER=mock
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# ★ 生产使用 real 时必须替换为真实 API Key（空 = mock，不会进入真实调用）
LLM_API_KEY=
LLM_MODEL=
# 模型池（额度耗尽自动切换，逗号分隔；不配用代码默认池 glm→kimi→qwen）
# LLM_MODEL_POOL=glm-5.2,kimi-k2.7-code,qwen3.7-max-2026-06-08
# real 失败降级 mock（评测/对比请设 0 让失败如实暴露）
LLM_DEGRADE_TO_MOCK=1
# LangFuse 观测（配好自托管平台再开）
# LLM_ENABLE_LANGFUSE=0
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3300

# ---- Redis（共享层）----
REDIS_URL=redis://127.0.0.1:16380/0
REDIS_ENABLED=1
# REDIS_SOCKET_TIMEOUT=1.0
# REDIS_IDEM_TTL=300
# REDIS_CACHE_TTL=60
# REDIS_LOCK_TTL=30

# ---- Qdrant / Embedding（kb 检索）----
QDRANT_URL=http://localhost:6333
SCM_COLLECTION=scm_kb_v1
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 数据文件：默认指向 scm-copilot/data；迁移期可指到旧 stage3-a/data（W5 已建索引）
# CHUNKS_FILE=../stage3-project-a/data/chunks_title.json
# BM25_CACHE_FILE=../stage3-project-a/data/bm25_index_cache.json
# SEMANTIC_ROUTER_SAMPLES_FILE=../stage3-project-a/data/semantic_router_samples.json
# SEMANTIC_ROUTER_VECTORS_FILE=../stage3-project-a/data/semantic_router_vectors.json

# ---- ops（业务操作域）----
# mock 业务系统地址（mock_biz_server，迁移期仍在 stage3-project-b）
BIZ_BASE_URL=http://127.0.0.1:8794
# ★ W23 Day5：审批单存储迁 MySQL 平台库（默认平台库 DSN，一般无需设置）
# APPROVAL_DSN=mysql+asyncmy://root:root123@127.0.0.1:13306/scm_platform?charset=utf8mb4
# LangGraph checkpointer 后端：mysql（默认，平台库）| sqlite（本地兜底）
CHECKPOINTER_BACKEND=mysql
# 幂等/审计文件级兜底（幂等主后端已是 Redis；审计文件级保留）
# IDEMPOTENCY_DB=
# AUDIT_LOG=
# 报表异步队列（RQ）
# TASK_QUEUE_ENABLED=1
# TASK_QUEUE_JOB_TIMEOUT=300
# TASK_QUEUE_RESULT_TTL=300

# ---- 观测（结构化日志 / Prometheus / OTEL）----
# SERVICE_NAME=scm-copilot
# INSTANCE_ID=
# STRUCT_LOG_ENABLED=1
# METRICS_ENABLED=1
# OTEL_ENABLED=1
# OTEL_EXPORTER=console
# OTEL_OTLP_ENDPOINT=
