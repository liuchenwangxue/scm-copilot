# ==================== SCM Copilot 平台环境变量（复制为 .env 后填写） ====================
# 前缀：SCM_（pydantic-settings env_prefix）

# ---- 双库 DSN（本地默认：deploy/docker-compose.yml 起的 MySQL，宿主端口 13306）----
SCM_PLATFORM_DSN=mysql+asyncmy://root:root123@127.0.0.1:13306/scm_platform?charset=utf8mb4
SCM_BIZ_DSN=mysql+asyncmy://root:root123@127.0.0.1:13306/scm_biz?charset=utf8mb4

# ---- JWT（Day3 使用，生产必改）----
SCM_JWT_SECRET=dev-secret-change-me

# ---- Redis（Day5 起使用；本机部署时宿主端口 16380，见 stage3 deploy）----
SCM_REDIS_URL=redis://127.0.0.1:16380/0
